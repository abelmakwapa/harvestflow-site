# Public application origin. This value is embedded in the browser bundle.
NEXT_PUBLIC_HARVESTFLOW_APP_URL=http://localhost:5173

# Server-only backend API base used by /api/leads. Do not prefix with NEXT_PUBLIC_.
HARVESTFLOW_API_BASE_URL=http://127.0.0.1:8080/v1

# Optional. Omit until a real, monitored support mailbox is configured.
# NEXT_PUBLIC_HARVESTFLOW_SUPPORT_EMAIL=support@example.com
